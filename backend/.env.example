# ============================================================================
# Babycare - Backend (exemplo de configuração)
# Copie para .env e ajuste os valores conforme o seu ambiente.
# NUNCA commite o arquivo .env real.
# ============================================================================

# Porta HTTP do servidor
PORT=3000

# Conexão com o MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque-por-sua-senha
DB_NAME=babycare

# Chave secreta usada para assinar os tokens JWT.
# Use uma string longa e aleatória (ex.: gerada com `openssl rand -hex 32`).
JWT_SECRET=troque-por-uma-chave-secreta-longa
JWT_EXPIRES_IN=2h