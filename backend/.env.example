# Configuração para executar o backend diretamente no computador.
# Copie este arquivo para backend/.env e preencha os valores.
PORT=3000
NODE_ENV=development
JWT_SECRET=troque_por_um_segredo_aleatorio_com_mais_de_32_caracteres
JWT_EXPIRES_IN=2h

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=babycare
DB_PASSWORD=babycare_local_dev_only
DB_NAME=babycare

# Origens permitidas no navegador
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000
