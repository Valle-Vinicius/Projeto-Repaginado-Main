{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/src/pages/login/index.html" },
    { "source": "/login", "destination": "/src/pages/login/index.html" },
    { "source": "/login.html", "destination": "/src/pages/login/index.html" },
    { "source": "/dashboard", "destination": "/src/pages/dashboard/index.html" },
    { "source": "/dashboard.html", "destination": "/src/pages/dashboard/index.html" },
    { "source": "/produtos", "destination": "/src/pages/produtos/index.html" },
    { "source": "/produtos.html", "destination": "/src/pages/produtos/index.html" },
    { "source": "/estoque", "destination": "/src/pages/estoque/index.html" },
    { "source": "/estoque.html", "destination": "/src/pages/estoque/index.html" },
    { "source": "/recebimentos", "destination": "/src/pages/recebimentos/index.html" },
    { "source": "/recebimentos.html", "destination": "/src/pages/recebimentos/index.html" },
    { "source": "/expedicoes", "destination": "/src/pages/expedicoes/index.html" },
    { "source": "/expedicoes.html", "destination": "/src/pages/expedicoes/index.html" },
    { "source": "/auditoria", "destination": "/src/pages/auditoria/index.html" },
    { "source": "/auditoria.html", "destination": "/src/pages/auditoria/index.html" },
    { "source": "/relatorios", "destination": "/src/pages/relatorios/index.html" },
    { "source": "/relatorios.html", "destination": "/src/pages/relatorios/index.html" },
    { "source": "/validade", "destination": "/src/pages/validade/index.html" },
    { "source": "/validade.html", "destination": "/src/pages/validade/index.html" },
    { "source": "/usuarios", "destination": "/src/pages/usuarios/index.html" },
    { "source": "/usuarios.html", "destination": "/src/pages/usuarios/index.html" },
    { "source": "/configuracoes", "destination": "/src/pages/configuracoes/index.html" },
    { "source": "/configuracoes.html", "destination": "/src/pages/configuracoes/index.html" },
    {
      "source": "/formulario-produto",
      "destination": "/src/pages/formulario-produto/index.html"
    },
    {
      "source": "/formulario-produto.html",
      "destination": "/src/pages/formulario-produto/index.html"
    },
    {
      "source": "/redefinir-senha",
      "destination": "/src/pages/redefinir-senha/index.html"
    },
    {
      "source": "/redefinir-senha.html",
      "destination": "/src/pages/redefinir-senha/index.html"
    },
    { "source": "/erro404", "destination": "/src/pages/erro404/index.html" },
    { "source": "/erro404.html", "destination": "/src/pages/erro404/index.html" }
  ]
}
