# =============================================================================
# BABYCARE - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de subir o projeto.
# =============================================================================

# Porta do backend (Node.js + Express)
PORT=3000

# Ambiente: development | production
NODE_ENV=development

# Chave secreta para assinar JWT (mude para algo seguro e longo!)
JWT_SECRET=chave_local_de_desenvolvimento_com_mais_de_32_caracteres

# PostgreSQL (local; no Docker Compose o host é configurado automaticamente)
DB_HOST=localhost
DB_PORT=5432
DB_USER=babycare
DB_PASSWORD=babycare_local_dev_only
DB_NAME=babycare

# URL pública do frontend (usada em CORS e redirecionamentos)
# Em produção: https://seu-app.railway.app
FRONTEND_URL=http://localhost:5173

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000

# URL da API exposta ao frontend (via VITE_API_URL)
VITE_API_URL=http://localhost:3000/api
