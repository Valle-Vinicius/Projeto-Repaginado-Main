# =============================================================================
# BABYCARE - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de subir o projeto.
# =============================================================================

# Porta do backend (Node.js + Express)
PORT=3000

# Ambiente: development | production
NODE_ENV=production

# Chave secreta para assinar JWT (mude para algo seguro e longo!)
JWT_SECRET=sua_chave_secreta_muito_segura_aqui_minimo_32_caracteres

# URL do banco de dados (MySQL ou PostgreSQL/Supabase)
# Exemplo MySQL: mysql://usuario:senha@host:3306/babycare
# Exemplo PostgreSQL: postgres://usuario:senha@host:5432/babycare
DATABASE_URL=mysql://root:senha@localhost:3306/babycare

# URL pública do frontend (usada em CORS e redirecionamentos)
# Em produção: https://seu-app.railway.app
FRONTEND_URL=http://localhost:5173

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# URL da API exposta ao frontend (via VITE_API_URL)
VITE_API_URL=http://localhost:3000/api
